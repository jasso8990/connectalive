# Ejemplo de variables de entorno. Estas van al panel de Netlify
# (Site → Environment variables), NO al repo.
#
# LiveKit Cloud — se crean en https://cloud.livekit.io (cuenta gratis)
LIVEKIT_URL=wss://xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — la service role key SÓLO vive en el servidor.
# La sacas de: Supabase → Project Settings → API → service_role secret.
